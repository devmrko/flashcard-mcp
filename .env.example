# Copy to .env (chmod 600). Never commit .env. Everything is optional for local use.

# Bind address. 127.0.0.1 = this computer only (no auth needed).
# Anything else (or a reverse proxy domain) requires WEB_AUTH and MCP_TOKENS below.
FLASHCARD_HOST=127.0.0.1
FLASHCARD_PORT=8810
# Public domain served by Caddy/nginx (see deploy/examples). Empty = localhost only.
FLASHCARD_PUBLIC_HOST=

# Web sign-in: simple (HTTP Basic, default) | google (Google account, allow-listed emails)
FLASHCARD_AUTH=simple
# simple: "user:pass"
FLASHCARD_WEB_AUTH=
# google: see docs/guides/google-sso.md
# FLASHCARD_GOOGLE_CLIENT_ID=
# FLASHCARD_GOOGLE_CLIENT_SECRET=
# FLASHCARD_ALLOWED_EMAILS=me@gmail.com
# FLASHCARD_SESSION_SECRET=            # `uv run flashcard new-token`

# One MCP token per client: label=token,... (token from `uv run flashcard new-token`).
# The label is stored as created_by/updated_by (e.g. mcp:claude).
FLASHCARD_MCP_TOKENS=

# Storage: sqlite (default, one local file) | oracle (Oracle Autonomous DB)
FLASHCARD_DB=sqlite
# sqlite: file path, relative to the project folder
FLASHCARD_SQLITE_PATH=flashcard.db

# oracle: wallet thin mode (download the wallet zip from the ADB console and unzip it)
# FLASHCARD_DB=oracle
# FLASHCARD_DB_USER=flashcard
# FLASHCARD_DB_PASSWORD=
# FLASHCARD_DB_DSN=mydb_low
# FLASHCARD_WALLET_DIR=/path/to/Wallet_MYDB
# FLASHCARD_WALLET_PASSWORD=
