# Copy to .env (chmod 600). Never commit .env.
FLASHCARD_HOST=0.0.0.0
FLASHCARD_PORT=8810
FLASHCARD_PUBLIC_HOST=flashcard.cloud-handson.com

# Oracle ADB (same instance as vector-knowledge, dedicated FLASHCARD schema)
FLASHCARD_DB_USER=flashcard
FLASHCARD_DB_PASSWORD=
FLASHCARD_DB_DSN=h8i4i0g8cxtd2lpf_low
FLASHCARD_WALLET_DIR=/Users/joungmin/devkit/db_conn/Wallet_H8I4I0G8CXTD2LPF
FLASHCARD_WALLET_PASSWORD=

# Web UI basic auth "user:pass".
# One MCP token per client/account: label=token,... (token from `uv run flashcard new-token`).
# The label is stored as created_by/updated_by (e.g. mcp:claude). Use labels like claude-work for a 2nd account.
FLASHCARD_WEB_AUTH=
FLASHCARD_MCP_TOKENS=claude=,codex=,chatgpt=

# Local dev without Oracle: FLASHCARD_DATABASE_URL=sqlite:///flashcard.db
